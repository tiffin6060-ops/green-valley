# Nothing is required. The app stores everything in ./data (database, uploads, session secret).
# Optional: set your own session secret (32+ chars) instead of the auto-generated one.
# AUTH_SECRET=

# Investment package requests (/invest) are e-mailed — set ONE of the options below (required for that form).
# Option A (free): send through Gmail. Turn on 2-Step Verification for trishalgreenvalley@gmail.com, then create an
# App Password at https://myaccount.google.com/apppasswords and paste the 16 characters here.
# GMAIL_USER=trishalgreenvalley@gmail.com
# GMAIL_APP_PASSWORD=
# Option B: Resend (https://resend.com). Sign up with trishalgreenvalley@gmail.com and paste an API key.
# RESEND_API_KEY=
# Optional: send package requests somewhere else (comma-separated). Default: trishalgreenvalley@gmail.com
# PLAN_NOTIFY_EMAIL=
